
# ==========================================
# Sensitive & Private Files
# ==========================================

/.env
/.env.*
!/.env.example
!/.env.testing.example

/EPSUpdate.md
/EsayXpres 12/Live_Credentials( EsayXpres)/Live_Credentials(EsayXpres).docx


# ==========================================
# Laravel Dependencies
# ==========================================

/vendor/
/node_modules/


# ==========================================
# Laravel Build Files
# ==========================================

/public/build/
/public/hot
/public/storage
/dist/
/build/


# ==========================================
# Laravel Cache & Runtime
# ==========================================

/bootstrap/cache/*
!/bootstrap/cache/.gitignore

/storage/*.key
/storage/app/*
!/storage/app/.gitignore

/storage/framework/cache/*
!/storage/framework/cache/.gitignore

/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore

/storage/framework/testing/*
!/storage/framework/testing/.gitignore

/storage/framework/views/*
!/storage/framework/views/.gitignore

/storage/logs/*
!/storage/logs/.gitignore


# ==========================================
# Database
# ==========================================

/database/*.sqlite
/database/*.sqlite-*
/database/*.db


# ==========================================
# APK, ZIP & Large Files
# ==========================================

/public/apk/*.apk
/easyxpress.zip

*.apk
*.aab
*.zip
*.rar
*.7z
*.tar
*.gz


# ==========================================
# Logs
# ==========================================

*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*


# ==========================================
# IDE & Editor
# ==========================================

/.idea/
/.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

*.sublime-workspace
*.sublime-project


